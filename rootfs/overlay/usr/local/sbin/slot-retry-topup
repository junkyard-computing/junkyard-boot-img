#!/bin/sh
# Give a freshly installed slot a bigger boot budget — ONCE — without ever
# disabling the bootloader's fallback.
#
# ★★ FALLING BACK TO FASTBOOT IS A FEATURE HERE, NOT A FAILURE.
#
# These units have no volume keys and no power button, and the BCB
# `bootonce-bootloader` route needs a booted, reachable OS. So there is NO way to
# put a fielded phone into fastboot by hand. The bootloader exhausting a slot's
# retries is the ONLY mechanism that will ever move an unreachable phone into a
# state a human with a USB cable can fix.
#
# That is why this does NOT call `mark-successful`. A committed slot never
# decrements (measured 2026-08-05: successful slots held at 7 across dozens of
# reboots; an uncommitted one went 15 -> 14 in a single boot), so committing
# would permanently switch off the only automatic route to recovery. A phone that
# boots happily but is unreachable, and can never fall back, is a brick even with
# physical access.
#
# What it does instead: raise the retry budget once per installed rootfs. The
# bootloader honours values above 7 — verified by writing 15 and watching it come
# back 14 after one boot — so this buys margin for the state every phone leaves
# the factory in (both halves flashed, neither committed, ~14 boots total) while
# leaving the fallback fully intact.
#
# Once per install, via a stamp under /var: the rootfs cutover replaces /var, so
# a new image gets a fresh budget, and repeated boots of the SAME image do not
# keep renewing it. Renewing every boot would make retries effectively infinite,
# which is the same mistake as committing, just less obvious.
#
# Only byte 0 (retry_count) is written. The flags byte is deliberately untouched:
# an earlier hand-write here clobbered fastboot_ok while clearing another bit,
# and flags are not this script's business.
set -u

DEVINFO=${DEVINFO:-/dev/disk/by-partlabel/devinfo}
BUDGET=${BUDGET:-15}
STAMP=${STAMP:-/var/lib/slot-retry-topup/done}

log() { logger -t slot-retry-topup "$*"; echo "slot-retry-topup: $*" > /dev/kmsg 2>/dev/null; }

[ -e "$STAMP" ] && exit 0
[ -b "$DEVINFO" ] || { log "no $DEVINFO — nothing to do"; exit 0; }

# devinfo layout (device/google/gs-common/bootctrl DevInfo.h): 128-byte struct,
# magic "DEVI", per-slot 4 bytes at offset 48 (A) / 52 (B), byte 0 = retry_count.
magic=$(dd if="$DEVINFO" bs=1 count=4 status=none 2>/dev/null | tr -d '\0')
[ "$magic" = "DEVI" ] || { log "devinfo magic is '$magic', not DEVI — refusing to write"; exit 0; }

case "$(grep -o 'slot_suffix = "[^"]*"' /proc/bootconfig 2>/dev/null | cut -d'"' -f2)" in
    _a) off=48; slot=A ;;
    _b) off=52; slot=B ;;
    *)  log "cannot determine the running slot — refusing to write"; exit 0 ;;
esac

before=$(dd if="$DEVINFO" bs=1 skip="$off" count=1 status=none 2>/dev/null | od -An -tu1 | tr -d ' ')

# Never lower an existing budget: if something already granted more, leave it.
if [ "${before:-0}" -ge "$BUDGET" ]; then
    log "slot $slot already has $before retries (>= $BUDGET) — leaving it"
    mkdir -p "$(dirname "$STAMP")" 2>/dev/null && : > "$STAMP"
    exit 0
fi

# printf needs an octal escape; 15 -> \017. Keep the two in step if BUDGET moves.
oct=$(printf '%03o' "$BUDGET")
if printf "\\$oct" | dd of="$DEVINFO" bs=1 seek="$off" count=1 conv=notrunc status=none 2>/dev/null; then
    sync
    after=$(dd if="$DEVINFO" bs=1 skip="$off" count=1 status=none 2>/dev/null | od -An -tu1 | tr -d ' ')
    if [ "$after" = "$BUDGET" ]; then
        log "slot $slot retry budget raised $before -> $after (once per install; fallback to fastboot still armed)"
        mkdir -p "$(dirname "$STAMP")" 2>/dev/null && : > "$STAMP"
    else
        log "wrote $BUDGET to slot $slot but it reads back $after — not stamping, will retry next boot"
    fi
else
    log "could not write $DEVINFO — leaving the budget at $before"
fi
exit 0
