#!/bin/sh
# Network-loss recovery. Run PERIODICALLY by netcheck-recover.timer.
#
# This is the only recovery path on the shipped configuration: no screen, no
# volume keys, no power button. If the device becomes unreachable over the
# network there is nobody to press anything, so it has to rescue itself.
#
# Escalation, on consecutive failed checks:
#   1..REBOOT_BEFORE_ROLLBACK   plain reboot   (clears a wedged or hung state)
#   thereafter                  mark this slot unbootable and reboot, so the
#                               bootloader falls back to the other slot
#
# It deliberately NEVER gives up. An earlier version stopped after 3 attempts to
# avoid reboot-looping a bench unit; on a device that cannot be touched that
# turns a recoverable fault into a permanent brick. A reboot loop is noisy but
# still trying, and rollback may land on a good slot. For bench use, create
#   /etc/netcheck-recover.disable
# and this exits immediately.
set -u
DEADLINE=${DEADLINE:-60}          # seconds to wait for an address before acting
REBOOT_BEFORE_ROLLBACK=${REBOOT_BEFORE_ROLLBACK:-3}
BOOTCTL=/usr/local/bin/pixel-bootctl
STATE=/var/lib/netcheck-recover
COUNTER="$STATE/attempts"

log() { logger -t netcheck-recover "$*"; echo "netcheck-recover: $*" > /dev/kmsg 2>/dev/null; }

[ -e /etc/netcheck-recover.disable ] && { log "disabled by /etc/netcheck-recover.disable"; exit 0; }

# Any global-scope IPv4 that is not a 169.254 autoconf address. Deliberately not
# tied to a subnet: these devices run on 10.0.0.0/24 in the datacenter and
# 192.168.1.0/24 on the bench, so hardcoding either prefix would make one of
# them permanently "failing".
have_ip() {
    ip -4 -o addr show scope global 2>/dev/null | awk '{print $4}' | grep -qv '^169\.254\.'
}

cur_slot() {
    "$BOOTCTL" status 2>/dev/null | awk '
        tolower($1)=="slot:" {s=tolower($2)}
        $1=="active:" && $2=="true" {print s; exit}'
}

# Give a transient blip a chance to clear before rebooting over it.
i=0
while [ "$i" -lt "$DEADLINE" ]; do
    if have_ip; then
        # Healthy. Commit this slot (this is what marks a slot good — nothing
        # else does, deliberately: a slot must PROVE it has network before the
        # bootloader stops being able to roll it back) and clear the counter.
        s=$(cur_slot)
        "$BOOTCTL" mark-successful ${s:+--slot "$s"} >/dev/null 2>&1 || true
        rm -f "$COUNTER"
        exit 0
    fi
    i=$((i + 1)); sleep 1
done

mkdir -p "$STATE" 2>/dev/null
attempts=$(cat "$COUNTER" 2>/dev/null)
case "$attempts" in ''|*[!0-9]*) attempts=0 ;; esac
attempts=$((attempts + 1))
echo "$attempts" > "$COUNTER" 2>/dev/null
sync

if [ "$attempts" -gt "$REBOOT_BEFORE_ROLLBACK" ]; then
    s=$(cur_slot)
    other_ok=$("$BOOTCTL" status 2>/dev/null | awk '
        tolower($1)=="slot:" {s=$2}
        $1=="active:"     {a[s]=$2}
        $1=="unbootable:" {ub[s]=$2}
        END { for (x in a) if (a[x]=="false" && ub[x]=="false") print "yes" }')
    if [ "$other_ok" = "yes" ]; then
        log "no IP after ${DEADLINE}s (attempt $attempts); marking slot ${s:-?} unbootable -> rollback"
        "$BOOTCTL" mark-unbootable ${s:+--slot "$s"} >/dev/null 2>&1 || true
    else
        log "no IP after ${DEADLINE}s (attempt $attempts); no usable fallback slot, plain reboot"
    fi
else
    log "no IP after ${DEADLINE}s (attempt $attempts/$REBOOT_BEFORE_ROLLBACK); rebooting"
fi

sync
systemctl reboot -f 2>/dev/null || /sbin/reboot -f
