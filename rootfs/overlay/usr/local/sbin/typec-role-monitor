#!/bin/sh
# Continuously HOLD the dwc3 data role at `device` while attached to a PC, so the
# USB gadget stays bound. Companion to typec-role-heal (which only fires once, on
# a udev partner-add): the gs201 DRP role-switch resolves the Type-C port to
# device correctly, but the dwc3 usb_role switch keeps flipping back to host
# mid-session, and a one-shot heal misses those later flips. The gadget then
# drops (usb0 disappears), which netcheck reads as "had an address, lost it" and
# reboots the unit ~every 5-16 min. Holding the role fixes both the flap and the
# reboot.
#
# ★ It must NOT break genuine host mode. A dongle/keyboard enumerates a downstream
# device; if anything is downstream we are legitimately host and leave the port
# alone. Same discriminator typec-role-heal uses: partner present AND nothing on
# the roothub == a PC that lost the DRP race == force device. Anything downstream
# == keep host. A settle delay before forcing covers a dongle mid-enumeration.
set -u
R=/sys/class/usb_role/11210000.usb-role-switch/role
P=/sys/class/typec/port0
POLL=${POLL:-2}
SETTLE=${SETTLE:-4}   # let a dongle finish PD+DR-swap+enum before we decide it's a PC

[ -w "$R" ] || { logger -t typec-role-monitor "no writable $R — exiting"; exit 0; }

downstream_device() {
    for d in /sys/bus/usb/devices/*/; do
        case "$(basename "$d")" in usb[0-9]*) continue ;; esac  # skip roothubs
        [ -f "$d/idVendor" ] && return 0                        # a real device downstream
    done
    return 1
}

while :; do
    if [ "$(cat "$R" 2>/dev/null)" = host ] && [ -d "$P-partner" ]; then
        # Stably host with a partner. Is it a PC (nothing downstream) or a dongle?
        sleep "$SETTLE"
        if [ "$(cat "$R" 2>/dev/null)" = host ] && [ -d "$P-partner" ] && ! downstream_device; then
            echo device > "$R" 2>/dev/null
            [ "$(cat "$R" 2>/dev/null)" = device ] \
                && logger -t typec-role-monitor "held role host->device (PC, no downstream)"
        fi
    fi
    sleep "$POLL"
done
