#!/bin/sh
# Recover a USB-Ethernet dongle that failed to re-attach after a reboot.
#
# THE FAILURE THIS FIXES STRANDS A NETWORK-ONLY DEVICE.
#
# The dongle is powered by the dock/hub, not by the phone, so it stays powered
# across the phone's reboot. When the phone resets, the dongle's USB link state
# machine is left orphaned with its host gone, and it never re-attaches to the
# newly booted host. Observed on 34291FDHS000WV: after a reboot the phone side
# was provably healthy —
#     exynos-dwc3 11210000.usb: set desired role to host
#     xhci-hcd-exynos: xHCI Host Controller / new USB bus registered (1 and 2)
#     Host supports USB 3.1 Enhanced SuperSpeed
# — and yet no `usb 2-1: new SuperSpeed USB device` ever appeared. No dongle, no
# address, no way in. Only a physical replug brought it back, which on a fielded
# unit with no screen and no buttons means a truck roll.
#
# Re-running host init does NOT help: the boot path already does exactly that
# and it is what failed. What works is forcing a Type-C DR_SWAP, which changes
# CC-line state and makes the downstream device see a disconnect/reconnect —
# the software equivalent of the replug. Measured: role device -> host, NIC back
# in 2 seconds.
#
# Runs at boot, does nothing when the dongle is present, and is a no-op on units
# that have no Type-C role control.
set -u
PORT=${PORT:-/sys/class/typec/port0/data_role}
GADGET_IF=${GADGET_IF:-usb0}
SETTLE=${SETTLE:-30}      # seconds to allow normal enumeration first
TRIES=${TRIES:-3}

log() { logger -t dongle-rehost "$*"; echo "dongle-rehost: $*" > /dev/kmsg 2>/dev/null; }

# A real wired NIC: a device symlink (excludes the ~44 virtual rmnet/gre/sit
# interfaces this kernel creates), ARPHRD_ETHER, and not the gadget itself.
have_nic() {
    for d in /sys/class/net/*; do
        n=$(basename "$d")
        [ "$n" = "lo" ] && continue
        [ "$n" = "$GADGET_IF" ] && continue
        [ -e "$d/device" ] || continue
        [ "$(cat "$d/type" 2>/dev/null)" = "1" ] && return 0
    done
    return 1
}

# Give normal enumeration a chance before intervening.
i=0
while [ "$i" -lt "$SETTLE" ]; do
    have_nic && exit 0
    i=$((i + 1)); sleep 1
done

[ -w "$PORT" ] || { log "no writable $PORT — cannot re-host; leaving alone"; exit 0; }

t=0
while [ "$t" -lt "$TRIES" ]; do
    t=$((t + 1))
    log "no wired NIC after ${SETTLE}s (attempt $t/$TRIES) — forcing Type-C DR_SWAP"
    echo device > "$PORT" 2>/dev/null
    sleep 5
    echo host   > "$PORT" 2>/dev/null
    i=0
    while [ "$i" -lt 30 ]; do
        if have_nic; then
            log "dongle re-attached after DR_SWAP (attempt $t)"
            exit 0
        fi
        i=$((i + 1)); sleep 1
    done
done

# Never leave a network-only device parked in device role.
echo host > "$PORT" 2>/dev/null
log "dongle did NOT re-attach after $TRIES DR_SWAP attempts; role forced back to host"
exit 1
