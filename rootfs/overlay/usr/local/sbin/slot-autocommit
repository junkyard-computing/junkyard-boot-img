#!/bin/sh
# Commit the running A/B slot when a rollback could not achieve anything.
#
# ★★ WHY THIS EXISTS: EVERY PHONE LEAVES THE FACTORY IN THE ONE DANGEROUS STATE.
#
# flash-fastboot.sh writes the same image into BOTH halves of super, and neither
# half has ever proven a network, so neither is committed. The bootloader gives
# each uncommitted slot 7 boots; measured 2026-08-05, a slot marked successful
# NEVER decrements, while one that is not goes down by one per boot (15 -> 14 in
# a single reboot). So a freshly provisioned phone has ~14 boots of margin, total,
# and nothing renews it until it reaches a network.
#
# Spend those 14 and the bootloader has no bootable slot: it lands in FASTBOOT on
# the next power-on, even after a clean shutdown. On a fielded unit — no screen,
# no buttons, no battery, network-only — fastboot is USB-only, so the phone sits
# there powered and completely unreachable. A PDU power-cycle just returns it to
# fastboot. That is a truck roll.
#
# The realistic path is not exotic: a rack installed before its network is live,
# power-cycled a few times during installation.
#
# ★ THE RULE: if the other half holds the SAME image version, a rollback cannot
# change anything, so committing costs nothing and removes the cliff entirely.
#
#   - Fresh factory flash  -> halves identical  -> commit. Correct: the fallback
#     is byte-identical, so rollback protection is protecting nothing while the
#     retry counter drains towards fastboot.
#   - After an OTA         -> halves differ     -> do nothing. Correct: this is
#     exactly when rollback matters, and it stays fully armed.
#   - OTA to the same version twice -> halves identical -> commit. Also correct,
#     because a rollback there is a no-op either way.
#
# Deliberately NOT in netcheck-recover: that is the only thing keeping a
# screenless device alive, and it has no business loop-mounting filesystems. A
# bug in here must not be able to take recovery down with it.
#
# Fails closed: any error reading the other half leaves the slot uncommitted,
# which is the status quo, not a regression.
set -u

BOOTCTL=${BOOTCTL:-/usr/local/bin/pixel-bootctl}
SUPER=${SUPER:-/dev/disk/by-partlabel/super}
MNT=/run/slot-autocommit-other

log() { logger -t slot-autocommit "$*"; echo "slot-autocommit: $*" > /dev/kmsg 2>/dev/null; }

[ -x "$BOOTCTL" ] || { log "no $BOOTCTL — nothing to do"; exit 0; }

mine=$(cat /etc/image-version 2>/dev/null)
[ -n "$mine" ] || { log "no /etc/image-version — leaving the slot uncommitted"; exit 0; }

# The inactive half of super, read-only. super is one partition split into two
# equal halves by dm-linear; the running slot picks which. Offsets are computed
# rather than hardcoded so this survives a change of partition size.
other_version() {
    [ -b "$SUPER" ] || return 1
    _total=$(blockdev --getsize64 "$SUPER" 2>/dev/null) || return 1
    [ "${_total:-0}" -gt 0 ] || return 1
    _half=$(( _total / 2 )); _half=$(( _half - (_half % 4096) ))
    case "$(grep -o 'slot_suffix = "[^"]*"' /proc/bootconfig 2>/dev/null | cut -d'"' -f2)" in
        _a) _off=$_half ;;
        _b) _off=0 ;;
        *)  return 1 ;;
    esac
    _lo=$(losetup -f --read-only -o "$_off" --sizelimit "$_half" --show "$SUPER" 2>/dev/null) || return 1
    mkdir -p "$MNT" 2>/dev/null
    # noload skips journal recovery — mandatory on a read-only mount of a
    # filesystem that may not have been cleanly unmounted.
    if mount -o ro,noload "$_lo" "$MNT" 2>/dev/null; then
        cat "$MNT/etc/image-version" 2>/dev/null
        umount "$MNT" 2>/dev/null
    fi
    losetup -d "$_lo" 2>/dev/null
    rmdir "$MNT" 2>/dev/null
}

other=$(other_version)

if [ -z "$other" ]; then
    log "could not read the other half — leaving the slot uncommitted"
    exit 0
fi

if [ "$mine" = "$other" ]; then
    # mark-successful is idempotent, so this needs no "is it already committed?"
    # check — and deliberately has none. An earlier attempt parsed
    # `pixel-bootctl status` for that and got it wrong, because `successful:`
    # is printed BEFORE `active:` in each slot block, so it judged the active
    # slot by the other slot's flag.
    if "$BOOTCTL" mark-successful >/dev/null 2>&1; then
        log "both halves hold $mine — a rollback would change nothing; slot committed"
    else
        log "both halves hold $mine but mark-successful FAILED"
    fi
else
    log "halves differ (running $mine, other $other) — leaving rollback armed"
fi
exit 0
